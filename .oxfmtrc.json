{
    "useTabs": false,
    "tabWidth": 4,
    "printWidth": 80,
    "singleQuote": false,
    "jsxSingleQuote": false,
    "quoteProps": "as-needed",
    "trailingComma": "all",
    "semi": true,
    "arrowParens": "always",
    "bracketSameLine": false,
    "bracketSpacing": true,
    "ignorePatterns": [
        ".agent/**",
        ".agents/**",
        ".claude/**",
        ".codex/**",
        ".continue/**",
        ".cursor/**",
        ".gemini/**",
        ".opencode/**",
        ".pi/**",
        ".roo/**",
        ".windsurf/**",
        ".impeccable/**",
        ".omo/**",
        "tools/oxlint/anti-slop/**"
    ],
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "overrides": [
        {
            "files": ["*.tsx"],
            "options": {
                "tabWidth": 2
            }
        }
    ]
}
